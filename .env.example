# Copy to .env. Only the provider you use needs a key.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_ENABLE_THINKING=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: run read-only subagents on another configured model alias.
SUBAGENT_MODEL=
